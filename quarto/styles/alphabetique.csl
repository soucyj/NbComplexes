<?xml version="1.0" encoding="utf-8"?>
<!-- Style « alphabétique » pour la version web : imite le style
     alphabetic de biblatex utilisé dans le PDF ([Koc04], [BD85]...).
     Les étiquettes (citation-label) sont celles calculées par biblatex,
     reprises par _outils/pre-rendu.py dans _bibliographie-web.json. -->
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0"
       default-locale="fr-FR">
  <info>
    <title>Alphabétique (livrejs)</title>
    <id>livrejs-alphabetique</id>
    <updated>2026-10-02T00:00:00+00:00</updated>
  </info>
  <macro name="auteurs">
    <names variable="author">
      <name and="text" delimiter=", " delimiter-precedes-last="never"
            initialize-with=". " name-as-sort-order="none"/>
      <substitute>
        <names variable="editor"/>
      </substitute>
    </names>
  </macro>
  <macro name="titre">
    <choose>
      <if type="book report thesis" match="any">
        <text variable="title" font-style="italic"/>
      </if>
      <else>
        <text variable="title" prefix="« " suffix=" »"/>
      </else>
    </choose>
  </macro>
  <macro name="annee">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <citation>
    <layout prefix="[" suffix="]" delimiter="; ">
      <text variable="citation-label"/>
    </layout>
  </citation>
  <bibliography second-field-align="flush" entry-spacing="0">
    <sort>
      <key variable="citation-label"/>
    </sort>
    <layout suffix=".">
      <text variable="citation-label" prefix="[" suffix="]"/>
      <group delimiter=". ">
        <text macro="auteurs"/>
        <text macro="titre"/>
        <group delimiter=", ">
          <text variable="container-title" font-style="italic"/>
          <group delimiter=" ">
            <text variable="volume"/>
            <text variable="issue" prefix="(" suffix=")"/>
          </group>
          <text variable="publisher"/>
          <text variable="publisher-place"/>
          <text macro="annee"/>
          <text variable="page" prefix="p. "/>
        </group>
        <text variable="note"/>
        <text variable="URL"/>
      </group>
    </layout>
  </bibliography>
</style>
