% reel (ancienne source : images/reel/reel.tex)
\begin{tikzpicture}[scale=5.5/4]
  \draw (-2,0) -> (2,0);
  \draw[fill=black] (0,0) circle (1.25pt) node[below]{$0$};
  \draw[fill=black] (1.25,0) circle (1.25pt) node[below]{$x$};
  \draw[fill=black] (-1.5,0) circle (1.25pt) node[below]{$y$};
  \draw[|-|, dashed] (0,0.5) -- (1.25,0.5);
  \draw[|-|, dashed,firebrick3] (0,0.75) -- (-1.5,0.75);
  \draw (0.625,0.5) node[above]{$|x|$};
  \draw[firebrick3] (-0.75,0.75) node[below]{$|y|$};
\end{tikzpicture}
