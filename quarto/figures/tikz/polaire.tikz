% polaire (ancienne source : images/polaire/polaire.tex)
\begin{tikzpicture}[scale=5.5/3]
  \tkzDefPoint(0,0){O}
  \tkzDefPoint(-1,0){A}
  \tkzDefPoint(1,0){B}
  \tkzDefPoint(0,-1){C}
  \tkzDefPoint(0,2){D}
  \tkzDefPoint(2,0){E}
  \tkzDefPoint(0.7071,0.7071){P}
  \tkzLabelPoints[above](P)
  \tkzLabelPoints[below left](O)
  \tkzMarkAngle[fill=fill1,size=3mm,arrows=->](E,O,P)
  \tkzMarkAngle[size=3mm,arrows=->](E,O,P)
  \tkzLabelAngle[pos=.5](B,O,P){$\theta$}
  \tkzLabelSegment[anchor=south, rotate=45, pos=0.5](O,P){$r$}
  \draw[->,color=black] (A) -- (E) node[below] {\small $\RE$};
  \draw[->,color=black] (C) -- (D) node[left] {\small $\IM$};
  \tkzDrawSegments(O,P)
  \tkzDrawPoints(P,O)
\end{tikzpicture}
