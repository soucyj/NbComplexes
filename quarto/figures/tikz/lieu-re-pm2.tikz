% reelle2 (ancienne source : images/reelle2/reelle2.tex)
\begin{tikzpicture}[scale=5.5/6]
  \draw[->,color=black] (-3,0) -- (3,0);
  \foreach \x in {-2,-1,1,2}
  \draw[shift={(\x,0)},color=black] (0pt,1pt) -- (0pt,-1pt) node[below right] {\footnotesize $\x$};
  \draw[->,color=black] (0,-3) -- (0,3);
  \draw[firebrick3, thick] (-2,-3) -- (-2,3);
  \draw[firebrick3, thick] (2,-3) -- (2,3);
  \draw[color=black] node[below] (A) at (3,0) {\small $\RE$};
  \draw[color=black] node[left] (B) at (0,3) {\small $\IM$};
\end{tikzpicture}
